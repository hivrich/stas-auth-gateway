NODE_ENV=production
PORT=3337
STAS_BASE=http://127.0.0.1:3336
STAS_INTERNAL_BASE_URL=http://127.0.0.1:3336
STAS_PGURL=postgres://USER:PASSWORD@HOST:5432/DB?sslmode=disable
STAS_KEY=__SET_IN_ENV__
DB_BRIDGE_API_KEY=__SET_IN_ENV__
STAS_API_KEY=__SET_IN_ENV__
INTERVALS_API_BASE_URL=https://intervals.icu/api/v1
ICU_API_BASE_URL=https://intervals.icu/api/v1
ICU_BASE_URL=https://intervals.icu/api/v1
GATEWAY_BASE_URL=https://intervals.stas.run
# Dedicated secrets are preferred. MCP_OAUTH_TOKEN_SECRET signs only MCP
# access/refresh tokens. OAUTH_STATE_SECRET signs OAuth state and DCR client ids;
# when either is unset its documented fallback applies and rotation has the
# corresponding conditional effect.
MCP_OAUTH_TOKEN_SECRET=
OAUTH_STATE_SECRET=
INTERVALS_CLIENT_ID=__SET_IN_ENV__
INTERVALS_CLIENT_SECRET=__SET_IN_ENV__
AGENT_AUTH_ENABLED=false
AGENT_AUTH_TOKEN_SECRET=__SET_IN_ENV__
